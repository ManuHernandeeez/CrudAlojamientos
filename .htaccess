RewriteEngine On
RewriteBase /CrudAlojamiento/


RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php/$1 [L,QSA]


<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>


<FilesMatch "^(database\.php|config\.php)$">
    Order allow,deny
    Deny from all
</FilesMatch>